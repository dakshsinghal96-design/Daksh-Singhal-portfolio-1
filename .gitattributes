# App source uses LF consistently.
* text=auto eol=lf

# The archived builds are historical artefacts: store them byte-for-byte.
# Without `-text`, Git would rewrite their line endings on checkout and the
# mirrored copies would no longer match what was originally published.
public/p/** -text
public/s/** -text
legacy-archive.html -text

# Binary assets must never be touched.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.webm binary
*.woff binary
*.woff2 binary
*.pdf binary
